parametersSchema:
    bladestan: structure([
        compiledViewPath: string()
        reportUnanalysedTemplates: bool()
    ])

parameters:
    # Where compiled blade templates are written. Project-local on purpose:
    # analysis `paths` can only expand %rootDir%/%currentWorkingDirectory%/%env%
    # (never %tmpDir%), and configs loaded through phpstan/extension-installer
    # cannot contribute analysis paths at all — so users opt in to template
    # analysis by adding this directory to their own `paths` (and .gitignore):
    #
    #     parameters:
    #         paths:
    #             - src
    #             - .bladestan
    #
    # The bootstrap only compiles templates when the directory is among the
    # analysed paths; without it, call-site signature validation still works.
    bladestan:
        compiledViewPath: %currentWorkingDirectory%/.bladestan
        # Warn on stderr when `.bladestan` is missing from the analysed paths, so
        # a template left unanalysed is a visible misconfiguration rather than a
        # silent one. Set to false if you only want view() call-site validation.
        reportUnanalysedTemplates: true

    bootstrapFiles:
        - ../bootstrap.php

    # Noise from constructs Blade emits in compiled templates that a template
    # author cannot act on. Each entry is pinned to the exact message as well
    # as the identifier and the compiled-view path, so a same-identifier error
    # with any other wording still surfaces. The /* makes the path an fnmatch
    # pattern: PHP's fnmatch * crosses directory separators, and patterns skip
    # the existence check that a bare directory path would fail before the
    # bootstrap has created it.
    ignoreErrors:
        # A component body is wrapped in a closure that Blade forwards the whole
        # component scope into ($errors, $__env, $app, $attributes, $componentName,
        # ...), of which most bodies read only a few.
        -
            message: '#^Anonymous function has an unused use \$[^ ]+\.$#'
            identifier: closure.unusedUse
            path: %bladestan.compiledViewPath%/*
            reportUnmatched: false
        # @error('field') compiles to `$__errorArgs[1] ?? 'default'`, reading the
        # optional error-bag slot that a single-argument @error never sets.
        -
            message: '#^Offset 1 on array\{''[^'']*''\} on left side of \?\? does not exist\.$#'
            identifier: nullCoalesce.offset
            path: %bladestan.compiledViewPath%/*
            reportUnmatched: false
        # Blade compiles @props default handling to `$prop = $prop ?? $default`,
        # whose left side is never nullable once the prop has been extracted
        # from the attribute bag.
        -
            message: '#^Expression on left side of \?\? is not nullable\.$#'
            identifier: nullCoalesce.expr
            path: %bladestan.compiledViewPath%/*
            reportUnmatched: false
        # Blade compiles a prop list without defaults (@props(['a', 'b'])) to a
        # foreach over array_filter([...], 'is_string', ARRAY_FILTER_USE_KEY),
        # whose integer keys always leave an empty array.
        -
            message: '#^Empty array passed to foreach\.$#'
            identifier: foreach.emptyArray
            path: %bladestan.compiledViewPath%/*
            reportUnmatched: false
        # Blade compiles @props prop extraction to a non-strict in_array($key,
        # $propNames), which phpstan-strict-rules flags for the missing third
        # argument. The array is Blade-built, so the author cannot make it strict.
        -
            message: '#^Call to function in_array\(\) requires parameter \#3 to be set\.$#'
            path: %bladestan.compiledViewPath%/*
            reportUnmatched: false
        # Blade's @props block opens with `$attributes ??= new ComponentAttributeBag()`.
        # The component scope declares $attributes, so that guard reads as redundant.
        -
            message: '#^Variable \$[^ ]+ on left side of \?\?= always exists and is not nullable\.$#'
            path: %bladestan.compiledViewPath%/*
            reportUnmatched: false

rules:
    - Bladestan\Rules\ViewCallSiteRule

services:
    errorFormatter.blade:
        class: Bladestan\ErrorReporting\PHPStan\ErrorFormatter\BladeTemplateErrorFormatter
        arguments:
            simpleRelativePathHelper: @simpleRelativePathHelper
            showTipsOfTheDay: %tipsOfTheDay%
            editorUrl: %editorUrl%
            editorUrlTitle: %editorUrlTitle%
            compiledViewPath: %bladestan.compiledViewPath%

    - PhpParser\PrettyPrinter\Standard
    - PhpParser\ConstExprEvaluator

    - Bladestan\Laravel\View\BladeCompilerFactory
    -
        class: Illuminate\View\Compilers\BladeCompiler
        factory: ['@Bladestan\Laravel\View\BladeCompilerFactory', 'create']

    - Bladestan\Blade\PhpLineToTemplateLineResolver
    - Bladestan\NodeAnalyzer\TemplateFilePathResolver
    - Bladestan\NodeAnalyzer\LaravelViewFunctionMatcher
    - Bladestan\NodeAnalyzer\MailablesContentMatcher
    - Bladestan\NodeAnalyzer\BladeViewMethodsMatcher
    - Bladestan\NodeAnalyzer\ViewDataParametersAnalyzer
    - Bladestan\NodeAnalyzer\ViewVariableAnalyzer
    - Bladestan\NodeAnalyzer\CompactFunctionCallParameterResolver
    - Bladestan\NodeAnalyzer\MagicViewWithCallParameterResolver
    - Bladestan\NodeAnalyzer\ClassPropertiesResolver
    - Bladestan\NodeAnalyzer\ValueResolver
    - Bladestan\Compiler\BladeToPHPCompiler
    - Bladestan\Compiler\ComponentScopeResolver
    - Bladestan\Compiler\FileNameAndLineNumberAddingPreCompiler
    - Bladestan\Compiler\LivewireTagCompiler
    - Bladestan\Compiler\SignatureExtractor
    - Bladestan\Compiler\SignatureMerger
    - Bladestan\Compiler\TypeStringValidator
    - Bladestan\NodeAnalyzer\TemplateVariableTypesResolver
    - Bladestan\PhpParser\NodeVisitor\BladeLineNumberNodeVisitor
    - Bladestan\PhpParser\ArrayStringToArrayConverter
    - Bladestan\PhpParser\SimplePhpParser
    - Bladestan\Discovery\TemplateDiscovery

    -
        class: Bladestan\Configuration\BladestanConfiguration
        arguments:
            compiledViewPath: %bladestan.compiledViewPath%

    -
        class: Bladestan\PhpParser\NodeVisitor\ViewFunctionArgumentsNodeVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor

    -
        class: Bladestan\PHPStan\BladeSignatureCacheMetaExtension
        tags:
            - phpstan.resultCacheMetaExtension
