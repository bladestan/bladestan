includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max

    paths:
        - src
        - tests

    excludePaths:
        - 'tests/*/Fixture/*'
        - 'tests/Rules/data/*'
        - 'tests/skeleton/resources/views/*'

    exceptions:
        reportUncheckedExceptionDeadCatch: true
        implicitThrows: false
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
        uncheckedExceptionClasses:
            - 'Bladestan\Exception\ShouldNotHappenException'
            - 'Nette\Utils\JsonException'
            - 'ReflectionException'
            - 'Webmozart\Assert\InvalidArgumentException'

    ignoreErrors:
        -
            identifier: missingType.checkedException
            path: tests/*
        # Exercising a PHPStan ErrorFormatter requires its own test harness
        # (ErrorFormatterTestCase) and the Error/AnalysisResult value objects,
        # none of which carry the backward-compatibility promise. This is the
        # same internal-API usage the formatter itself already inline-ignores,
        # confined here to the single test that drives it.
        -
            identifiers:
                - phpstanApi.class
                - phpstanApi.constructor
                - phpstanApi.method
            path: tests/ErrorReporting/BladeTemplateErrorFormatterTest.php
